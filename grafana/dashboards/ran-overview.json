      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alarms per incident",
      "description": "How many raised alarms the correlator folds into each incident, in the selected time range. Higher means less noise for the NOC.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "SELECT round(count(*)::numeric / NULLIF(count(DISTINCT incident_id), 0), 1) AS ratio FROM alarms WHERE event = 'raise' AND $__timeFilter(ts)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network availability (%)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "SELECT time, 100.0 * (500 - down) / 500 AS \"availability %\" FROM (\n  SELECT ts AS time,\n         sum(CASE WHEN event = 'raise' THEN 1 ELSE -1 END) OVER (ORDER BY ts, id) AS down\n  FROM alarms WHERE alarm = 'NODE_DOWN') s\nWHERE $__timeFilter(time) ORDER BY time",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alarms raised per minute, by severity",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), severity AS metric, count(*) AS value\nFROM alarms WHERE event = 'raise' AND $__timeFilter(ts)\nGROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "major"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "minor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Open incidents",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "SELECT 'INC-' || id AS incident, kind AS cause, root AS origin, hub,\n       site_count AS sites, alarm_count AS alarms,\n       extract(epoch FROM now() - opened_at) AS open_for\nFROM incidents WHERE status = 'open'\nORDER BY site_count DESC, opened_at",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "open_for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "displayName",
                "value": "open for"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cause"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "incident"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "origin"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hub"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alarms"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sites"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Sites down by region",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "WITH last AS (\n  SELECT DISTINCT ON (node) node, region, event FROM alarms\n  WHERE alarm = 'NODE_DOWN' ORDER BY node, id DESC)\n,\nregions(region) AS (VALUES ('NORTH'), ('SOUTH'), ('EAST'), ('WEST'), ('CENTRAL'))\nSELECT r.region, count(l.node) FILTER (WHERE l.event = 'raise') AS down\nFROM regions r LEFT JOIN last l ON l.region = r.region\nGROUP BY r.region ORDER BY r.region",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "lcd",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Sites with the most incidents",
      "description": "Sites that keep failing. Step 10 will flag these automatically.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "SELECT root AS site, region, hub, count(*) AS incidents,\n       count(*) FILTER (WHERE kind = 'NODE_DOWN') AS outages,\n       max(opened_at) AS last_incident\nFROM incidents\nWHERE root LIKE 'gNB-%' AND status <> 'merged' AND $__timeFilter(opened_at)\nGROUP BY root, region, hub ORDER BY incidents DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    }
  ]
}
