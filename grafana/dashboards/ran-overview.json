        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "SELECT count(*) AS open FROM incidents WHERE status = 'open'",
          "format": "table",
