      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "WITH last AS (\n  SELECT DISTINCT ON (node) node, region, event FROM alarms\n  WHERE alarm = 'NODE_DOWN' ORDER BY node, id DESC)\nSELECT count(*) FILTER (WHERE event = 'raise') AS down FROM last",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
