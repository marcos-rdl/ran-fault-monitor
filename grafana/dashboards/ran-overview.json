{
  "uid": "ran-overview",
  "title": "RAN Fault Monitor",
  "tags": [
    "ran",
    "noc"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability now",
      "description": "Share of the 500 sites that are not down right now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ranmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ranmon-pg"
          },
          "rawSql": "WITH last AS (\n  SELECT DISTINCT ON (node) node, region, event FROM alarms\n  WHERE alarm = 'NODE_DOWN' ORDER BY node, id DESC)\nSELECT 100.0 * (500 - count(*) FILTER (WHERE event = 'raise')) / 500 AS availability FROM last",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sites down",
      "description": "",
